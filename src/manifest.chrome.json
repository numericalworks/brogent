{
  "manifest_version": 3,
  "name": "Brogent",
  "version": "0.2.0",
  "description": "An AI browser agent for Chrome: read, summarize, extract from, and modify the current tab with Ollama, OpenAI, Anthropic, Gemini, or any OpenAI-compatible model.",
  "minimum_chrome_version": "135",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["sidePanel", "scripting", "storage", "tabs", "userScripts"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open Brogent",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
